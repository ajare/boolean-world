{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ajare.github.io/boolean-world/schemas/resource-manifest/v1/lua-script.schema.json",
  "title": "LuaScript Resource",
  "$ref": "#/definitions/resource",
  "definitions": {
    "choiceCollection": {
      "oneOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/scalar" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/scalar" }
        }
      ]
    },
    "stringParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "default"],
      "properties": {
        "name": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString" },
        "type": { "pattern": "^[Ss][Tt][Rr][Ii][Nn][Gg]$" },
        "default": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/scalar" },
        "Choices": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Choice"],
          "properties": {
            "Choice": { "$ref": "#/definitions/choiceCollection" }
          }
        }
      }
    },
    "integerParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "default", "min", "max"],
      "properties": {
        "name": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString" },
        "type": { "pattern": "^[Ii][Nn][Tt][Ee][Gg][Ee][Rr]$" },
        "default": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/integer" },
        "min": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/integer" },
        "max": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/integer" }
      }
    },
    "numberParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "default", "min", "max"],
      "properties": {
        "name": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString" },
        "type": { "pattern": "^[Nn][Uu][Mm][Bb][Ee][Rr]$" },
        "default": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/number" },
        "min": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/number" },
        "max": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/number" }
      }
    },
    "booleanParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "default"],
      "properties": {
        "name": { "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString" },
        "type": { "pattern": "^[Bb][Oo][Oo][Ll][Ee][Aa][Nn]$" },
        "default": { "enum": [true, false, "true", "false"] }
      }
    },
    "parameter": {
      "oneOf": [
        { "$ref": "#/definitions/stringParameter" },
        { "$ref": "#/definitions/integerParameter" },
        { "$ref": "#/definitions/numberParameter" },
        { "$ref": "#/definitions/booleanParameter" }
      ]
    },
    "parameterCollection": {
      "oneOf": [
        { "$ref": "#/definitions/parameter" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/parameter" }
        }
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Param"],
      "properties": {
        "Param": { "$ref": "#/definitions/parameterCollection" }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Params": { "$ref": "#/definitions/params" }
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Definition"],
      "properties": {
        "Definition": { "$ref": "#/definitions/definition" }
      }
    },
    "sourceDependency": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/dependentResource" },
        {
          "required": ["id", "ref"],
          "properties": {
            "id": { "enum": ["Source"] },
            "ref": {
              "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString",
              "x-willpower-editor-version": "1.0",
              "x-willpower-widget": "resource-reference",
              "x-willpower-allowed-resource-types": ["TextFile"],
              "x-willpower-reference-scope": "manifest"
            }
          }
        }
      ]
    },
    "includeDependency": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/dependentResource" },
        {
          "required": ["ref"],
          "properties": {
            "ref": {
              "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString"
            }
          },
          "not": {
            "required": ["id"],
            "properties": { "id": { "enum": ["Source"] } }
          }
        }
      ]
    },
    "dependency": {
      "oneOf": [
        { "$ref": "#/definitions/sourceDependency" },
        { "$ref": "#/definitions/includeDependency" }
      ]
    },
    "dependencyCollection": {
      "oneOf": [
        { "$ref": "#/definitions/dependency" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/dependency" }
        }
      ]
    },
    "dependentResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DependentResource"],
      "properties": {
        "DependentResource": { "$ref": "#/definitions/dependencyCollection" }
      }
    },
    "resource": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/resource" },
        {
          "required": ["name"],
          "properties": {
            "type": { "enum": ["LuaScript"] },
            "location": {
              "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString",
              "x-willpower-editor-version": "1.0",
              "x-willpower-widget": "file",
              "x-willpower-file-kind": "Lua scripts",
              "x-willpower-file-extensions": ["lua"]
            },
            "DependentResources": { "$ref": "#/definitions/dependentResources" },
            "Definitions": { "$ref": "#/definitions/definitions" }
          },
          "not": { "required": ["Option"] }
        }
      ]
    }
  }
}
