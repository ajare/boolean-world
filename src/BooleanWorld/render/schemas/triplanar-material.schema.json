{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ajare.github.io/boolean-world/schemas/resource-manifest/v1/triplanar-material.schema.json",
  "title": "TriplanarMaterial Resource",
  "$ref": "#/definitions/resource",
  "definitions": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Albedo"],
      "properties": {
        "Albedo": { "enum": ["Albedo"] },
        "TileWidth": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 1024,
          "default": 32
        },
        "BlendSharpness": {
          "type": "number",
          "minimum": 1,
          "maximum": 16,
          "default": 4
        }
      }
    },
    "definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Definition"],
      "properties": {
        "Definition": { "$ref": "#/definitions/definition" }
      }
    },
    "albedoDependency": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/dependentResource" },
        {
          "required": ["id", "ref"],
          "properties": {
            "id": { "enum": ["Albedo"] },
            "ref": {
              "$ref": "https://schemas.willpower.dev/resource-manifest/common.schema.json#/definitions/nonEmptyString",
              "x-willpower-editor-version": "1.0",
              "x-willpower-widget": "resource-reference",
              "x-willpower-allowed-resource-types": ["Image"],
              "x-willpower-reference-scope": "manifest"
            }
          }
        }
      ]
    },
    "dependentResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DependentResource"],
      "properties": {
        "DependentResource": { "$ref": "#/definitions/albedoDependency" }
      }
    },
    "resource": {
      "allOf": [
        { "$ref": "https://schemas.willpower.dev/resource-manifest/resource.schema.json#/definitions/resource" },
        {
          "required": ["name", "DependentResources", "Definitions"],
          "properties": {
            "type": { "enum": ["TriplanarMaterial"] },
            "DependentResources": { "$ref": "#/definitions/dependentResources" },
            "Definitions": { "$ref": "#/definitions/definitions" }
          },
          "not": {
            "anyOf": [
              { "required": ["location"] },
              { "required": ["Option"] }
            ]
          }
        }
      ]
    }
  }
}
